NODE_ENV=development
APP_ENV=development
ALLOW_TEST_SEED=false
PORT=3000
DATABASE_URL="postgresql://user:pass@host:5432/tabletime?schema=public"
JWT_SECRET="เปลี่ยนเป็นสตริงสุ่ม-64-ตัวอักษร"
JWT_REFRESH_SECRET="เปลี่ยนเป็นสตริงสุ่มอีกชุด-64-ตัว"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_MAX_FAILED=5
AUTH_LOCK_MINUTES=15
CORS_ORIGIN="http://localhost:5173"
DEPOSIT_RATE=0.2
STORAGE_DRIVER=local
# Production: set STORAGE_DRIVER=cloudinary and provide these via the host's secret manager.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
